#!/usr/bin/env bash

#
# Pi extensions installer.
#
# Installs Pi extensions from this repository's `src/extensions/` directory into
# the Pi agent's extensions directory (`~/.pi/agent/extensions/`).
#
# Usage: ./run/install [extension-name...]
#
#   (no args)           Install all available extensions.
#   extension-name      Install one or more named extensions.
#   -l, --list          List available extensions and exit.
#   -h, --help          Show this help and exit.
#

# Strict mode:
#   -e            Exit on any unhandled command failure.
#   -u            Error on references to unset variables.
#   -o pipefail   A pipeline fails if any element fails (not just the last).

set -euo pipefail

# Use this instead for debugging problems with the script.
#set -euxo pipefail

#
# Global variables.
#

# Absolute path to this script's directory and the repository root, so the
# installer can be run from any working directory.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"

# Includes path.
inc_path="${script_dir}/inc"

# Where extension sources live in this repo, and where they install to. Each
# extension must exist at `${src_dir}/<name>/index.ts`.

# Read by the sourced helpers in run/inc/fn/.
# shellcheck disable=SC2034
src_dir="${repo_root}/src/extensions"

# Read by the sourced helpers in run/inc/fn/.
# shellcheck disable=SC2034
pi_extensions_dir="${HOME}/.pi/agent/extensions"

# Available extensions.
# Read by the sourced helpers in run/inc/fn/.
# shellcheck disable=SC2034
available_extensions=(
  "command-gate"
  "pickling-penguins"
  "tool-gate"
  "role-switcher"
)

# Seed role definitions shipped by this repo, and where `role-switcher`
# discovers user-level roles. Copied only when the target does not already
# exist, so a role the user has edited is never overwritten.

# Read by the sourced helpers in run/inc/fn/.
# shellcheck disable=SC2034
roles_src_dir="${repo_root}/src/roles"

# Read by the sourced helpers in run/inc/fn/.
# shellcheck disable=SC2034
pi_roles_dir="${HOME}/.pi/roles"

#
# Includes.
#

# Source ANSI code variables.
. "${inc_path}/var/ansi-codes.sh"

# Source utility functions.
. "${inc_path}/fn/statuses.sh"
. "${inc_path}/fn/banners.sh"
. "${inc_path}/fn/extensions.sh"

#
# Main script.
#

main() {
  print_header

  # Handle flags before doing any work.
  case "${1:-}" in
    -h|--help)
      show_usage
      echo ""
      exit 0
      ;;
    -l|--list)
      list_available_extensions
      echo ""
      exit 0
      ;;
  esac

  # Verify prerequisites and ensure the target directory exists.
  check_prerequisites

  # With no arguments, install everything; otherwise install the named ones.
  # Role seeds accompany `role-switcher`, so they are only laid down when that
  # extension is part of this run.
  if [[ $# -eq 0 ]]; then
    install_all_extensions
    install_role_seeds
  else
    install_named_extensions "$@"
    if printf '%s\n' "$@" | grep -qx "role-switcher"; then
      install_role_seeds
    fi
  fi

  post_install_instructions
  echo ""
}

main "$@"
